# --- HNavas agent backend — copy to .env and fill in. NEVER commit .env. ---

# Your OpenAI API key. SECRET — lives only here on the server, never in the
# frontend or the repo. Leave it unset to run the site's chat in demo mode.
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: override the model (default: gpt-4o-mini — the cheapest reliable one)
# AGENT_MODEL=gpt-4o-mini

# Optional: lock CORS to your site origin(s) in production (comma-separated).
# Defaults to "*" for local/demo convenience.
# ALLOWED_ORIGINS=https://hnavasystems.com,https://www.hnavasystems.com

# Optional: local dev port (default 3001)
# PORT=3001

# --- Agent tools (Phase 2). All optional — tools work without these. ---

# consultar_github tool: works tokenless (public API, 60 req/h). Set a GitHub
# token (SECRET, server-side only) to raise the limit to 5000 req/h.
# GITHUB_TOKEN=github_pat_xxx
# Optional: which GitHub user to report on (default: diegomur09)
# GITHUB_USER=diegomur09

# agendar_llamada tool: your online booking link (e.g. a Cal.com URL). If unset,
# the agent falls back to scheduling by email.
# CALENDAR_URL=https://cal.com/diego/intro
