# --- HNavas agent backend — copy to .env and fill in. NEVER commit .env. ---

# Your OpenAI API key. SECRET — lives only here on the server, never in the
# frontend or the repo. Leave it unset to run the site's chat in demo mode.
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: override the model (default: gpt-4o-mini — the cheapest reliable one)
# AGENT_MODEL=gpt-4o-mini

# JWT signing secret for the auth/lead-inbox API. REQUIRED in any real
# deployment (Lambda): the app refuses to start without a strong value (>=32
# random chars), so tokens are never signed with a guessable key. Use a
# different secret per environment: openssl rand -hex 32
# Locally it is optional — a throwaway dev key is used when unset.
# JWT_SECRET=replace-with-openssl-rand-hex-32

# ── RAG / retrieval (all optional, defaults in src/retrieve.js) ──────────────
# EMBED_MODEL=text-embedding-3-small   # must match the model build.mjs used
# RAG_TOP_K=5                          # chunks handed to the model
# RAG_MIN_SCORE=0.2                    # minimum cosine to count as relevant
# RAG_LEX_MIN=4                        # raw BM25 that rescues an exact keyword
# RAG_SEMANTIC_WEIGHT=0.65             # ranking blend: meaning
# RAG_LEXICAL_WEIGHT=0.35              # ranking blend: words

# Optional: lock CORS to your site origin(s) in production (comma-separated).
# Defaults to "*" for local/demo convenience.
# ALLOWED_ORIGINS=https://hnavasystems.com,https://www.hnavasystems.com

# Optional: local dev port (default 3001)
# PORT=3001

# --- Agent tools (Phase 2). All optional — tools work without these. ---

# consultar_github tool: works tokenless (public API, 60 req/h). Set a GitHub
# token (SECRET, server-side only) to raise the limit to 5000 req/h.
# GITHUB_TOKEN=github_pat_xxx
# Optional: which GitHub user to report on (default: diegomur09)
# GITHUB_USER=diegomur09

# agendar_llamada / agendar_reunion: your online booking link (e.g. a Cal.com
# URL). Optional — when set, meeting confirmation emails include it for instant
# self-booking; when unset, the flow is request + email confirmation only.
# CALENDAR_URL=https://cal.com/diego/intro

# --- Email (Amazon SES) — sends lead notifications + confirmations. ---
# All optional: defaults are baked into src/email.js so no Lambda env change is
# needed. The Lambda's IAM role needs ses:SendEmail; FROM must be on the
# SES-verified hnavasystems.com domain. Locally, your AWS credentials are used.
# SES_FROM=HNavas Systems <noreply@hnavasystems.com>
# LEAD_NOTIFY_EMAIL=hnavasystems@gmail.com   # where lead/meeting alerts land
# SES_REPLY_TO=hnavasystems@gmail.com        # where client replies go
